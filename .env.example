# ========================================================
# CẤU HÌNH BOT SĂN SALE & HOÀN TIỀN (RUST + LIBSQL)
# ========================================================

# 1. Telegram Bot Token (Lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Username của Bot (Không có dấu @, dùng để tạo link giới thiệu)
BOT_USERNAME=vvipass_vip_bot

# 3. Cổng chạy Web Admin Dashboard (Render tự động cấp PORT=10000)
PORT=10000

# 4. Tài khoản Quản trị viên Web Admin (Chỉ duy nhất 1 tài khoản, không cho đăng ký)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DealX@Admin2026

# 5. Cấu hình Cơ sở dữ liệu LibSQL
# - Mặc định lưu file SQLite cục bộ tại thư mục dự án (ổ F)
DATABASE_PATH=salehunter.db
# - Hoặc nếu muốn dùng Turso Cloud (LibSQL Remote):
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token

# 4. Tỉ lệ Hoàn tiền & Hoa hồng (%)
# Hoàn lại cho người mua hàng (% trên tổng hoa hồng sàn chi trả)
CASHBACK_RATE=70.0
# Thưởng cho người giới thiệu F0 (% trên tổng hoa hồng sàn chi trả)
REFERRAL_BONUS_RATE=10.0
# Mức rút tiền tối thiểu (VNĐ)
MIN_WITHDRAWAL_VND=50000

# 5. ACCESSTRADE API Access Key & Deeplink (Lấy từ pub.accesstrade.vn/accounts/profile)
ACCESSTRADE_API_TOKEN=your_accesstrade_api_token_here
# Mẫu Deeplink dự phòng nếu chưa dùng API Token:
ACCESSTRADE_DEEPLINK_TEMPLATE=

# 6. Telegram Webhook 24/7 (Khi chạy trên Render, biến RENDER_EXTERNAL_URL được cấp tự động)
# Chỉ cần điền nếu dùng domain riêng (nếu để trống ở local, bot chạy Long Polling):
# WEBHOOK_BASE_URL=https://bot-sale.onrender.com
# TELEGRAM_WEBHOOK_SECRET=your_custom_webhook_secret_here
# SHORTLINK_BASE_URL=https://thegioisieusale.click
