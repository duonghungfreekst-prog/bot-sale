# ========================================================
# CẤU HÌNH BOT SĂN SALE & HOÀN TIỀN (CHẠY TRỰC TIẾP TRÊN PC)
# ========================================================

# 1. Telegram Bot Token (Lấy từ @BotFather trên Telegram; bỏ trống/comment để dùng cấu hình dự phòng có sẵn)
# TELEGRAM_BOT_TOKEN=

# 2. Username của Bot (Không có dấu @, dùng để tạo link giới thiệu)
BOT_USERNAME=vvipass_vip_bot

# 3. Cổng chạy Web Admin Dashboard trên PC (Mở http://127.0.0.1:10000/admin)
PORT=10000

# 4. Tài khoản Quản trị viên Web Admin (Chỉ duy nhất 1 tài khoản, không cho đăng ký)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DealX@Admin2026

# 5. Cấu hình Cơ sở dữ liệu LibSQL
# - Chạy trực tiếp trên PC (Local): tự lưu file SQLite cục bộ ngay trong thư mục dự án trên ổ F:
DATABASE_PATH=salehunter.db
# - BẮT BUỘC khi chạy Hosting / Cloud (Render, Railway, Fly, Docker có WEBHOOK_BASE_URL):
#   Hệ thống sẽ TỪ CHỐI fallback về SQLite file để tránh mất dữ liệu khi restart container.
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token

# 6. Tỉ lệ Hoàn tiền & Hoa hồng (%)
CASHBACK_RATE=70.0
REFERRAL_BONUS_RATE=10.0
MIN_WITHDRAWAL_VND=50000

# 7. ACCESSTRADE API Access Key & Deeplink (Lấy từ pub2.accesstrade.vn -> Công cụ -> API)
ACCESSTRADE_API_TOKEN=
ACCESSTRADE_DEEPLINK_TEMPLATE=

# 8. Bọc link rút gọn mặc định qua https://thegioisieusale.click (ghi `off` nếu muốn gửi link Affiliate trần)
# Nếu tự mở Cloudflare Tunnel / Webhook riêng ra Internet mới cần điền WEBHOOK_BASE_URL:
# WEBHOOK_BASE_URL=
# TELEGRAM_WEBHOOK_SECRET=
# SHORTLINK_BASE_URL=https://thegioisieusale.click
# CLOUDFLARE_TUNNEL_TOKEN=
